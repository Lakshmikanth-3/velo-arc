{
  "name": "velo402-arc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "arc:compile": "node scripts/arc-compile.mjs",
    "arc:test:ui": "tsx --test scripts/arc-ui.test.ts",
    "arc:testnet:setup": "tsx scripts/arc-testnet-setup.ts",
    "arc:testnet:e2e": "tsx --env-file=.env.arc-testnet --test scripts/arc-testnet-e2e.test.ts",
    "arc:testnet:browser": "tsx --env-file=.env.arc-testnet --test scripts/arc-browser-testnet.test.ts",
    "arc:test": "node --test scripts/arc-contract.test.mjs scripts/arc-adversarial.test.mjs && tsx --test src/lib/arc/config.test.ts scripts/arc-sdk.test.ts scripts/arc-gateway-buyer.test.ts",
    "arc:preflight": "tsx scripts/arc-deploy.ts",
    "arc:deploy": "tsx scripts/arc-deploy.ts --broadcast",
    "arc:smoke": "tsx scripts/arc-smoke.ts",
    "arc:agent": "tsx agent/arc-runner.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "pnpm arc:test",
    "arc:testnet:x402": "tsx --env-file=.env.arc-testnet --test scripts/arc-x402.test.ts",
    "arc:testnet:demo-setup": "tsx --env-file=.env.arc-testnet scripts/arc-testnet-demo-setup.ts",
    "arc:ai-agent": "tsx agent/ai-agent.ts",
    "arc:watch": "tsx agent/watch.ts",
    "arc:ready": "tsx scripts/arc-mainnet-readiness.ts",
    "arc:test:ui-full": "tsx --test scripts/arc-ui-full.test.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "4.0.0",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
